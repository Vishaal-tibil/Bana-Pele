# The only thing that should ever be exposed to the internet (tunnel THIS port,
# 3010): the /v1 REST API for the partner backend and our three web apps, and
# nothing else.
#
# Everything else on the buyer app (the built-in page's /api/* routes and the
# unauthenticated webhook the adapter calls back) stays on the internal
# network, as do the adapters themselves.
#
# CORS: browsers may call /v1 only from the origins matched by
# CORS_ORIGINS_REGEX (default: the three Bana Pele Firebase sites and
# localhost for development). Calls still need the X-Api-Key.
{
    auto_https off
    admin off
}

:3010 {
    @allowed_origin header_regexp Origin {$CORS_ORIGINS_REGEX:^(https://bana-pele-(naledi|ngo|thabo)-ui\.(web\.app|firebaseapp\.com)|http://(localhost|127\.0\.0\.1)(:[0-9]+)?)$}

    handle /v1/* {
        header @allowed_origin {
            Access-Control-Allow-Origin "{http.request.header.Origin}"
            Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS"
            Access-Control-Allow-Headers "X-Api-Key, Content-Type"
            Access-Control-Max-Age "600"
        }
        header Vary Origin

        @preflight method OPTIONS
        respond @preflight 204

        # The edge alone decides CORS: drop the app's own (internal, "*") headers.
        reverse_proxy sandbox-bap:3001 {
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Headers
            header_down -Access-Control-Allow-Methods
        }
    }
    handle {
        respond "not found" 404
    }
}
