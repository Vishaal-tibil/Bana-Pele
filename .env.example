# ./setup.sh copies this next to docker-compose and fills in API_KEY.
# You normally never edit it by hand.
#
# API_KEY        shared secret the partner sends in X-Api-Key (generated by ./setup.sh)
# MATCH_URL      partner endpoint we ask "does this provider match?" (set by ./connect.sh)
# EVENTS_URL     partner webhook we push events to                   (set by ./connect.sh)
API_KEY=
MATCH_URL=
EVENTS_URL=
